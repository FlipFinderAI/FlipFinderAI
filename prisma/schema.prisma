
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Property {
  id Int @id @default(autoincrement())

  externalId String @unique
  address String
  postcode String
  type String
  description String?
  listingUrl String?
  agent String?
  source String?
  images String?

  price Int
  estimatedValue Int?
  soldComparableAvg Int?
  discountPercent Int?

  bedrooms Int?
  bathrooms Int?
  floorArea Int?
  tenure String?
  epcRating String?

  refurbRequired Boolean @default(false)
  kitchenCost Int?
  bathroomCost Int?
  decorationCost Int?
  extensionCost Int?
  totalRefurbCost Int?

  purchaseCosts Int?
  stampDuty Int?
  legalCosts Int?
  totalInvestment Int?
  resaleValue Int?
  potentialProfit Int?
  rentalValue Int?
  yield Float?

  aiScore Int?
  aiConfidence Int?
  aiRecommendation String?
  aiSummary String?
  aiOpportunities String?
  aiRisks String?

  photoAnalysis String?
  detectedIssues String?
  refurbPlan String?

  valuationReasoning String?
  comparableAnalysis String?
  marketAnalysis String?

  aiTrainingData String?
  actualOutcome String?
  dealSuccessful Boolean?

  dateListed DateTime?
  lastSeen DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos PropertyPhoto[]
  analyses AIAnalysis[]
}

model PropertyPhoto {
  id Int @id @default(autoincrement())

  propertyId Int
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  url String

  aiDescription String?
  detectedRoom String?
  conditionScore Int?
  estimatedRepairCost Int?

  createdAt DateTime @default(now())
}

model ComparableSale {
  id Int @id @default(autoincrement())

  transactionId String? @unique

  postcode     String
  address      String?
  soldPrice    Int
  soldDate     DateTime?

  bedrooms     Int?
  bathrooms    Int?
  floorArea    Int?
  epcRating    String?

  propertyType String?
  source       String?

  createdAt DateTime @default(now())
}

model AIAnalysis {
  id Int @id @default(autoincrement())

  propertyId Int
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  model String
  prompt String
  response String
  confidence Int?

  createdAt DateTime @default(now())
}

model MarketData {
  id Int @id @default(autoincrement())

  postcode String
  averagePrice Int?
  averageRent Int?
  demandScore Int?
  growthRate Float?

  createdAt DateTime @default(now())
}

model LearningExample {
  id Int @id @default(autoincrement())

  propertyId Int?
  beforeAnalysis String?
  finalDecision String?
  actualResult String?
  profit Int?

  createdAt DateTime @default(now())
}
