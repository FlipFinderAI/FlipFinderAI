    if (!photoUri) return;
    void extractTicketPalette(photoUri, club.primary, fallbackSecondary).then(
      (result) => {
        if (alive) setPalette(result);
      },
    );
    void extractTicketQrDataUri(photoUri).then((result) => {
      if (alive) setQrUri(result);
