      if (!Number.isNaN(parsed.getTime()))
        kickoff = `${String(parsed.getHours()).padStart(2, "0")}:${String(parsed.getMinutes()).padStart(2, "0")}`;
    }
    const candidate: MatchCheckInFixture = {
      key: `next|${next.date}|${normaliseFixtureText(opponent)}`,
