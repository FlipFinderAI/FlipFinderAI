  const fullFrameColumns =
    fullFrameTickets.length <= 2
      ? 1
      : fullFrameTickets.length <= 4
        ? 2
        : fullFrameTickets.length <= 9
          ? 3
          : 4;
  const fullFrameRows = Math.max(
    1,
    Math.ceil(fullFrameTickets.length / fullFrameColumns),
