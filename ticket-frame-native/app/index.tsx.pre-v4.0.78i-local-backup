  ticketStyle: TicketStyle;
  club: ClubOption;
  oldSchoolAssets?: Record<string, string>;
  renderScale?: number;
}) {
  const columns =
    tickets.length <= 2
      ? 1
      : tickets.length <= 4
        ? 2
        : tickets.length <= 9
          ? 3
