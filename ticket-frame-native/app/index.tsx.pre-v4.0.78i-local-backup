  const rows = Math.max(1, Math.ceil(tickets.length / columns));
  const tileWidth = `${100 / columns - 0.7}%` as `${number}%`;
  const tileHeight = `${100 / rows - 0.7}%` as `${number}%`;
  return (
    <View style={[s.ticketGrid, { gap: 1 * renderScale }]}> 
      {tickets.map((ticket) => (
        <View
