      setNearbyVenuePanel((current) =>
        current?.groundId === ground.id && current.kind === kind
          ? {
              groundId: ground.id,
              kind,
              loading: false,
              error: !cached?.length,
              items: cached?.slice(0, 5) ?? [],
              distanceFrom,
            }
          : current,
      );
    }
