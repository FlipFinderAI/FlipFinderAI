{
  "name": "ticket-frame-native",
  "version": "1.1.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "expo lint",
    "api:check": "node scripts/checkFootballApiConfig.mjs",
    "api:sync": "node scripts/syncFootballDataCache.mjs && node scripts/syncOpenFootballCache.mjs && node scripts/buildMatchDatabase.mjs",
    "data:build": "node scripts/buildMatchDatabase.mjs",
    "openfootball:sync": "node scripts/syncOpenFootballCache.mjs",
    "api-football:plan": "node scripts/syncApiFootballCache.mjs --plan-only",
    "api-football:live": "node scripts/syncApiFootballCache.mjs",
    "api-football:history-plan": "node scripts/backfillApiFootballHistory.mjs --plan-only",
    "api-football:history": "node scripts/backfillApiFootballHistory.mjs",
    "openfootball:history": "node scripts/syncOpenFootballHistory.mjs",
    "openfootball:worldwide": "node scripts/syncOpenFootballWorldwide.mjs",
    "openfootball:rich": "node scripts/syncOpenFootballRichDetails.mjs",
    "highlightly:sync": "node scripts/syncHighlightlyCache.mjs",
    "highlightly:standings": "node scripts/syncHighlightlyCache.mjs --standings-only",
    "highlightly:stored-scores": "node scripts/backfillStoredScoreBreakdowns.mjs && node scripts/buildMatchDatabase.mjs",
    "highlightly:spare": "node scripts/useHighlightlySpareCapacity.mjs && node scripts/buildMatchDatabase.mjs",
    "highlightly:daily": "node scripts/runHighlightlyDailyMaintenance.mjs",
    "providers:race": "node scripts/raceCurrentFootballProviders.mjs",
    "tfd:generate": "node scripts/generatePublicTfdSnapshot.mjs",
    "tfd:publish": "node scripts/publishTfdToGitHub.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-ml-kit/barcode-scanning": "^2.0.0",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-native-picker/picker": "2.11.1",
    "@types/qrcode": "^1.5.6",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-video": "~3.0.16",
    "jpeg-js": "^0.4.4",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2",
    "wrangler": "^4.127.1"
  }
}
