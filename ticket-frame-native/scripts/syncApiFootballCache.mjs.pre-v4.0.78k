import {
  existsSync,
  readFileSync,
  writeFileSync,
} from "node:fs";
import { execFileSync } from "node:child_process";
import { resolve } from "node:path";
import {
  canonicalClub,
  findUniqueFixtureMatch,
} from "./tfdIdentity.mjs";

const root = process.cwd();

const secretsPath = resolve(
  root,
  ".ticket-frame-api-secrets",
);

const cachePath = resolve(
  root,
  "data/apiFootballCache.json",
);

const providerCachePath = resolve(
  root,
  "data/apiFootballProviderCache.json",
);

const matchDbPath = resolve(
  root,
  "data/matchDatabase.json",
);

const DAILY_LIMIT = 100;

const FINAL_STATUSES = new Set([
  "FT",
  "AET",
  "PEN",
  "AWD",
  "WO",
]);

const LIVE_STATUSES = new Set([
  "1H",
  "HT",
  "2H",
  "ET",
  "BT",
  "P",
  "INT",
  "LIVE",
]);

function loadJson(path, fallback) {
  if (!existsSync(path)) return fallback;

  return JSON.parse(
    readFileSync(path, "utf8"),
  );
}

function saveJson(path, value) {
  writeFileSync(
    path,
    `${JSON.stringify(value, null, 2)}\n`,
    "utf8",
  );
}

function readSecrets() {
  if (!existsSync(secretsPath)) {
    throw new Error(
      "Missing .ticket-frame-api-secrets",
    );
  }

  return Object.fromEntries(
    readFileSync(secretsPath, "utf8")
      .split(/\r?\n/)
      .map((line) => line.trim())
      .filter(
        (line) =>
          line &&
          !line.startsWith("#") &&
          line.includes("="),
      )
      .map((line) => {
        const i = line.indexOf("=");

        return [
          line.slice(0, i).trim(),
          line.slice(i + 1).trim(),
        ];
      }),
  );
}

function dateOnly(value) {
  return String(value ?? "").slice(0, 10);
}

function clubKey(value) {
  return canonicalClub(value);
}
function matchKey(row) {
  return [
    dateOnly(row.date ?? row.kickoff),
    clubKey(row.homeName),
    clubKey(row.awayName),
  ].join("|");
}

function kickoffMs(match) {
  const raw =
    match.kickoff ??
    (
      match.date
        ? `${match.date}T15:00:00Z`
        : null
    );

  if (!raw) return null;

  const value = new Date(raw).getTime();

  return Number.isFinite(value)
    ? value
    : null;
}

function todaysMatches(database, today) {
  const result = [];

  for (
    const [competition, seasons]
    of Object.entries(
      database.competitions ?? {},
    )
  ) {
    for (
      const [season, bundle]
      of Object.entries(seasons ?? {})
    ) {
      for (
        const match
        of bundle.fixtures ?? []
      ) {
        if (
          dateOnly(
            match.date ?? match.kickoff,
          ) !== today
        ) {
          continue;
        }

        result.push({
          ...match,
          competition,
          season,
        });
      }
    }
  }

  return result;
}

function kickoffBlocks(matches) {
  return [
    ...new Set(
      matches
        .map(kickoffMs)
        .filter((value) => value != null)
        .map(
          (value) =>
            Math.floor(value / 60000),
        ),
    ),
  ].sort((a, b) => a - b);
}

function preferredIntervalMinutes(
  activeBlockCount,
) {
  // One request fetches all today's fixtures.
  // Keep live refresh at 2 minutes; the existing budgetInterval
  // still protects the 100-call daily limit.
  return 2;
}

function calculatePlan(matches) {
  const blocks = kickoffBlocks(matches);

  const windows = blocks.map((start) => ({
    kickoffUtcMinutes: start,
    startUtcMinutes: start,
    endUtcMinutes: start + 120,
  }));

  return {
    matchCount: matches.length,
    blockCount: blocks.length,
    dailyLimit: DAILY_LIMIT,
    kickoffBlocksUtcMinutes: blocks,
    windows,
  };
}

function isLeagueCompetition(name) {
  const value = String(name ?? "")
    .toLowerCase();

  return ![
    "cup",
    "trophy",
    "shield",
    "champions league",
    "europa league",
    "conference league",
  ].some((word) => value.includes(word));
}

function calculateTable(fixtures) {
  const rows = new Map();

  const ensure = (id, name) => {
    const key =
      id ??
      `name:${clubKey(name)}`;

    if (!rows.has(key)) {
      rows.set(key, {
        teamId: id ?? key,
        name,
        played: 0,
        win: 0,
        draw: 0,
        loss: 0,
        goalsFor: 0,
        goalsAgainst: 0,
        goalDifference: 0,
        points: 0,
      });
    }

    return rows.get(key);
  };

  for (const fixture of fixtures) {
    if (
      fixture.homeScore == null ||
      fixture.awayScore == null
    ) {
      continue;
    }

    const home = ensure(
      fixture.homeId,
      fixture.homeName,
    );

    const away = ensure(
      fixture.awayId,
      fixture.awayName,
    );

    home.played++;
    away.played++;

    home.goalsFor += fixture.homeScore;
    home.goalsAgainst += fixture.awayScore;

    away.goalsFor += fixture.awayScore;
    away.goalsAgainst += fixture.homeScore;

    if (
      fixture.homeScore >
      fixture.awayScore
    ) {
      home.win++;
      home.points += 3;
      away.loss++;
    } else if (
      fixture.homeScore <
      fixture.awayScore
    ) {
      away.win++;
      away.points += 3;
      home.loss++;
    } else {
      home.draw++;
      away.draw++;
      home.points++;
      away.points++;
    }
  }

  for (const row of rows.values()) {
    row.goalDifference =
      row.goalsFor -
      row.goalsAgainst;
  }

  return [...rows.values()].sort(
    (a, b) =>
      b.points - a.points ||
      b.goalDifference -
        a.goalDifference ||
      b.goalsFor - a.goalsFor ||
      String(a.name).localeCompare(
        String(b.name),
      ),
  );
}

function findTfdMatch(
  matches,
  apiRow,
) {
  return findUniqueFixtureMatch(
    matches,
    {
      date:
        apiRow.fixture?.date,
      kickoff:
        apiRow.fixture?.date,
      homeName:
        apiRow.teams?.home?.name,
      awayName:
        apiRow.teams?.away?.name,
      competition:
        apiRow.league?.name ?? null,
    },
  );
}
function mapApiFixture(
  row,
  tfdMatch,
) {
  const statusShort =
    row.fixture?.status?.short ?? null;

  const isFinal =
    FINAL_STATUSES.has(
      statusShort,
    );

  const hasCurrentScore =
    isFinal ||
    LIVE_STATUSES.has(
      statusShort,
    );

  return {
    id: `api-football:${row.fixture?.id}`,
    providerId: String(
      row.fixture?.id ?? "",
    ),

    date:
      dateOnly(row.fixture?.date) ||
      tfdMatch.date,

    kickoff:
      row.fixture?.date ??
      tfdMatch.kickoff ??
      null,

    homeId:
      tfdMatch.homeId ?? null,

    awayId:
      tfdMatch.awayId ?? null,

    homeName:
      tfdMatch.homeName ??
      row.teams?.home?.name ??
      null,

    awayName:
      tfdMatch.awayName ??
      row.teams?.away?.name ??
      null,

    homeScore:
      hasCurrentScore
        ? row.goals?.home ?? null
        : null,

    awayScore:
      hasCurrentScore
        ? row.goals?.away ?? null
        : null,

    halfTimeHomeScore:
      row.score?.halftime?.home ?? null,

    halfTimeAwayScore:
      row.score?.halftime?.away ?? null,

    fullTimeHomeScore:
      isFinal ? row.score?.fulltime?.home ?? row.goals?.home ?? null : null,

    fullTimeAwayScore:
      isFinal ? row.score?.fulltime?.away ?? row.goals?.away ?? null : null,

    status:
      isFinal
        ? "FINISHED"
        : statusShort,

    season:
      tfdMatch.season,

    competition:
      tfdMatch.competition,

    venue:
      row.fixture?.venue?.name ??
      tfdMatch.venue ??
      null,

    attendance:
      tfdMatch.attendance ?? null,

    homeScorers:
      tfdMatch.homeScorers ?? [],

    awayScorers:
      tfdMatch.awayScorers ?? [],
  };
}

function mergeFixture(
  bundle,
  mapped,
) {
  const providerId =
    String(mapped.providerId);

  const identity =
    matchKey(mapped);

  const existingIndex =
    (bundle.fixtures ?? [])
      .findIndex(
        (row) =>
          String(
            row.providerId ?? "",
          ) === providerId ||
          matchKey(row) === identity,
      );

  if (existingIndex >= 0) {
    bundle.fixtures[
      existingIndex
    ] = {
      ...bundle.fixtures[
        existingIndex
      ],
      ...mapped,
    };
  } else {
    bundle.fixtures.push(mapped);
  }
}

function fixtureWithLiveOverride(
  fixture,
  providerFixtures,
) {
  const identity =
    matchKey(fixture);

  const live =
    providerFixtures.find(
      (row) =>
        matchKey(row) === identity,
    );

  if (!live) return fixture;

  return {
    ...fixture,

    homeScore:
      live.homeScore ??
      fixture.homeScore,

    awayScore:
      live.awayScore ??
      fixture.awayScore,

    status:
      live.status ??
      fixture.status,
  };
}

function rebuildAffectedTables(
  database,
  providerCache,
  affected,
) {
  for (
    const key of affected
  ) {
    const [competition, season] =
      key.split("|");

    if (
      !isLeagueCompetition(
        competition,
      )
    ) {
      continue;
    }

    const tfdBundle =
      database.competitions?.[
        competition
      ]?.[season];

    if (!tfdBundle) continue;

    providerCache
      .competitions[
        competition
      ] ??= {};

    providerCache
      .competitions[
        competition
      ][season] ??= {
        fixtures: [],
        table: [],
      };

    const providerBundle =
      providerCache
        .competitions[
          competition
        ][season];

    const provisionalFixtures =
      (tfdBundle.fixtures ?? [])
        .map(
          (fixture) =>
            fixtureWithLiveOverride(
              fixture,
              providerBundle.fixtures ??
                [],
            ),
        );

    providerBundle.table =
      calculateTable(
        provisionalFixtures,
      );
  }
}

async function apiFootball(
  path,
  apiKey,
) {
  const response = await fetch(
    `https://v3.football.api-sports.io${path}`,
    {
      headers: {
        "x-apisports-key":
          apiKey,
      },
    },
  );

  const body =
    await response.json();

  return {
    ok: response.ok,
    status: response.status,
    body,

    remaining:
      response.headers.get(
        "x-ratelimit-requests-remaining",
      ) ??
      response.headers.get(
        "x-ratelimit-remaining",
      ),
  };
}

function minutesSince(value) {
  if (!value) return Infinity;

  const ms =
    new Date(value).getTime();

  if (!Number.isFinite(ms)) {
    return Infinity;
  }

  return (
    Date.now() - ms
  ) / 60000;
}

function requestDecision(
  matches,
  day,
) {
  if (!matches.length) {
    return {
      due: false,
      purpose:
        "no TFD matches today",
      intervalMinutes: null,
    };
  }

  const now = Date.now();

  const kickoffs =
    matches
      .map(kickoffMs)
      .filter(
        (value) =>
          value != null,
      );

  if (!kickoffs.length) {
    return {
      due: false,
      purpose:
        "no known kick-off times",
      intervalMinutes: null,
    };
  }

  const active =
    matches.filter((match) => {
      const kickoff =
        kickoffMs(match);

      if (kickoff == null) {
        return false;
      }

      const status =
        String(
          match.status ?? "",
        ).toUpperCase();

      return (
        now >= kickoff &&
        (
          now <=
            kickoff +
              120 * 60000 ||
          LIVE_STATUSES.has(status)
        )
      );
    });

  const activeBlocks =
    kickoffBlocks(active).length;

  const firstKickoff =
    Math.min(...kickoffs);

  const lastExpectedFinish =
    Math.max(...kickoffs) +
    120 * 60000;

  const requestsMade =
    day.requestsMade ?? 0;

  const remainingCalls =
    Math.max(
      0,
      DAILY_LIMIT -
        requestsMade,
    );

  if (!remainingCalls) {
    return {
      due: false,
      purpose:
        "100-call daily limit reached",
      intervalMinutes: null,
    };
  }

  if (active.length) {
    const preferred =
      preferredIntervalMinutes(
        Math.max(
          1,
          activeBlocks,
        ),
      );

    const remainingLiveMinutes =
      Math.max(
        1,
        Math.ceil(
          (
            lastExpectedFinish -
            now
          ) /
            60000,
        ),
      );

    const budgetInterval =
      Math.max(
        1,
        Math.ceil(
          remainingLiveMinutes /
            remainingCalls,
        ),
      );

    const intervalMinutes =
      Math.max(
        preferred,
        budgetInterval,
      );

    return {
      due:
        minutesSince(
          day.lastRequestAt,
        ) >= intervalMinutes,

      purpose:
        "live scores + TFD tables",

      intervalMinutes,
    };
  }

  const minutesUntilFirst =
    (
      firstKickoff -
      now
    ) / 60000;

  if (
    minutesUntilFirst <= 60 &&
    minutesUntilFirst > 0
  ) {
    return {
      due:
        minutesSince(
          day.lastRequestAt,
        ) >= 60,

      purpose:
        "pre-match fixture/status check",

      intervalMinutes: 60,
    };
  }

  if (
    now > firstKickoff &&
    now <=
      lastExpectedFinish +
        180 * 60000
  ) {
    return {
      due:
        minutesSince(
          day.lastRequestAt,
        ) >= 15,

      purpose:
        "finished-result catch-up + final tables",

      intervalMinutes: 15,
    };
  }

  if (
    now >
      lastExpectedFinish +
        180 * 60000 &&
    !day.finalVerificationComplete
  ) {
    return {
      due: true,
      purpose:
        "final daily verification",

      intervalMinutes: null,
    };
  }

  return {
    due: false,
    purpose:
      "outside update window",
    intervalMinutes: null,
  };
}

function allMatchesConfirmed(
  matches,
  day,
) {
  return matches.every(
    (match) =>
      day.completedFixtures?.[
        match.id
      ] === true ||
      String(
        match.status ?? "",
      ).toUpperCase() ===
        "FINISHED",
  );
}

const args =
  new Set(
    process.argv.slice(2),
  );

const planOnly =
  args.has("--plan-only");

const statusOnly =
  args.has("--status");

const force =
  args.has("--force");

const requestedDateArg =
  process.argv.find(
    (arg) =>
      arg.startsWith(
        "--date=",
      ),
  );

function footballDate() {
  // TFD follows the UK football calendar, not the Mac/user timezone.
  // Keep the previous match day active until 04:00 UK time so late
  // finishes, final-result verification and tables can complete.
  const now = new Date();

  const parts = Object.fromEntries(
    new Intl.DateTimeFormat("en-GB", {
      timeZone: "Europe/London",
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      hourCycle: "h23",
    })
      .formatToParts(now)
      .filter((part) => part.type !== "literal")
      .map((part) => [part.type, part.value]),
  );

  let date = `${parts.year}-${parts.month}-${parts.day}`;

  if (Number(parts.hour) < 4) {
    const noonUtc = new Date(`${date}T12:00:00Z`);
    noonUtc.setUTCDate(noonUtc.getUTCDate() - 1);
    date = noonUtc.toISOString().slice(0, 10);
  }

  return date;
}

const today =
  requestedDateArg
    ? requestedDateArg.slice(
        "--date=".length,
      )
    : footballDate();

const database =
  loadJson(
    matchDbPath,
    {
      competitions: {},
    },
  );

const matches =
  todaysMatches(
    database,
    today,
  );

const plan =
  calculatePlan(matches);

const cache =
  loadJson(
    cachePath,
    {
      schemaVersion: 2,
      provider:
        "api-football",
      days: {},
    },
  );

cache.schemaVersion = 2;

cache.days[today] ??= {
  plan,
  requestsMade: 0,
  lastRequestAt: null,
  requestLog: [],
  liveSnapshots: [],
  completedFixtures: {},
  finalVerificationComplete:
    false,
};

const day =
  cache.days[today];

day.plan = plan;
day.requestLog ??= [];
day.liveSnapshots ??= [];
day.completedFixtures ??= {};

const decision =
  requestDecision(
    matches,
    day,
  );

console.log(
  "===== TICKET FRAME TFD LIVE FUNNEL =====",
);

console.log("Date:", today);
console.log(
  "TFD matches:",
  matches.length,
);
console.log(
  "Kick-off blocks:",
  plan.blockCount,
);
console.log(
  "API calls today:",
  `${day.requestsMade ?? 0} / ${DAILY_LIMIT}`,
);
console.log(
  "Remaining:",
  Math.max(
    0,
    DAILY_LIMIT -
      (day.requestsMade ?? 0),
  ),
);
console.log(
  "Next purpose:",
  decision.purpose,
);

if (
  decision.intervalMinutes != null
) {
  console.log(
    "Current interval:",
    `${decision.intervalMinutes} minute(s)`,
  );
}

if (planOnly || statusOnly) {
  console.log(
    planOnly
      ? "Plan only — API-Football was NOT contacted."
      : "Status only — API-Football was NOT contacted.",
  );

  process.exit(0);
}

if (
  !force &&
  !decision.due
) {
  saveJson(
    cachePath,
    cache,
  );

  console.log(
    "No API request due on this scheduler tick.",
  );

  process.exit(0);
}

if (
  (day.requestsMade ?? 0) >=
  DAILY_LIMIT
) {
  console.log(
    "100-call daily ceiling reached. No API request made.",
  );

  process.exit(0);
}

const secrets =
  readSecrets();

if (
  !secrets.API_FOOTBALL_KEY
) {
  throw new Error(
    "API_FOOTBALL_KEY is missing.",
  );
}

/*
 * One date request is deliberately used rather than separate
 * live/result requests. It can update live games, newly-finished
 * games, postponements and other fixture statuses in one API call.
 */
const path =
  `/fixtures?date=${today}`;

console.log(
  `API request: ${decision.purpose}`,
);

const result =
  await apiFootball(
    path,
    secrets.API_FOOTBALL_KEY,
  );

/*
 * Count every attempted provider request against our own ceiling.
 */
day.requestsMade =
  (day.requestsMade ?? 0) + 1;

day.lastRequestAt =
  new Date().toISOString();

day.requestLog.push({
  at: day.lastRequestAt,
  purpose:
    decision.purpose,
  path,
  providerRemaining:
    result.remaining,
  ok: result.ok,
  status: result.status,
});

if (
  day.requestLog.length > 300
) {
  day.requestLog =
    day.requestLog.slice(-300);
}

if (
  !result.ok ||
  Object.keys(
    result.body?.errors ?? {},
  ).length
) {
  saveJson(
    cachePath,
    cache,
  );

  console.error(
    "API-Football request failed:",
    result.status,
    result.body?.errors ?? {},
  );

  process.exitCode = 1;
} else {
  const apiRows =
    result.body?.response ?? [];

  day.liveSnapshots.push({
    fetchedAt:
      day.lastRequestAt,
    purpose:
      decision.purpose,
    remaining:
      result.remaining,
    fixtures: apiRows,
  });

  if (
    day.liveSnapshots.length > 100
  ) {
    day.liveSnapshots =
      day.liveSnapshots.slice(-100);
  }

  const providerCache =
    loadJson(
      providerCachePath,
      {
        schemaVersion: 1,
        generatedAt: null,
        source:
          "api-football/api-sports",
        accessPolicy:
          "Provider-authorised API-Football data used as a TFD enrichment/live source.",
        competitions: {},
      },
    );

  providerCache.competitions ??= {};

  const affected =
    new Set();

  let matched = 0;
  let liveCount = 0;
  let finalCount = 0;

  for (const apiRow of apiRows) {
    const tfdMatch =
      findTfdMatch(
        matches,
        apiRow,
      );

    if (!tfdMatch) {
      continue;
    }

    matched++;

    const mapped =
      mapApiFixture(
        apiRow,
        tfdMatch,
      );

    providerCache
      .competitions[
        mapped.competition
      ] ??= {};

    providerCache
      .competitions[
        mapped.competition
      ][mapped.season] ??= {
        fixtures: [],
        table: [],
      };

    const bundle =
      providerCache
        .competitions[
          mapped.competition
        ][mapped.season];

    mergeFixture(
      bundle,
      mapped,
    );

    affected.add(
      `${mapped.competition}|${mapped.season}`,
    );

    const apiStatus =
      apiRow.fixture?.status?.short;

    if (
      FINAL_STATUSES.has(
        apiStatus,
      )
    ) {
      finalCount++;

      day.completedFixtures[
        tfdMatch.id
      ] = true;
    } else if (
      LIVE_STATUSES.has(
        apiStatus,
      )
    ) {
      liveCount++;
    }
  }

  /*
   * Recalculate affected league tables immediately from TFD's
   * existing season plus the newest API-Football score overrides.
   *
   * This costs ZERO extra API requests.
   */
  rebuildAffectedTables(
    database,
    providerCache,
    affected,
  );

  providerCache.generatedAt =
    new Date().toISOString();

  saveJson(
    providerCachePath,
    providerCache,
  );

  saveJson(
    cachePath,
    cache,
  );

  /*
   * Push provider changes through the real TFD builder immediately.
   */
  if (matched > 0) {
    execFileSync(
      process.execPath,
      [
        resolve(
          root,
          "scripts/buildMatchDatabase.mjs",
        ),
      ],
      {
        cwd: root,
        stdio: "inherit",
      },
    );
  }

  const freshDatabase =
    loadJson(
      matchDbPath,
      {
        competitions: {},
      },
    );

  const freshMatches =
    todaysMatches(
      freshDatabase,
      today,
    );

  if (
    Date.now() >
      Math.max(
        ...matches
          .map(kickoffMs)
          .filter(
            (value) =>
              value != null,
          ),
        0,
      ) +
        120 * 60000 &&
    allMatchesConfirmed(
      freshMatches,
      day,
    )
  ) {
    day.finalVerificationComplete =
      true;

    day.finalVerificationAt =
      new Date().toISOString();

    saveJson(
      cachePath,
      cache,
    );
  }

  console.log(
    `Matched ${matched} TFD fixture(s).`,
  );

  console.log(
    `Live: ${liveCount} | Finished: ${finalCount}`,
  );

  console.log(
    `Affected TFD competition/season tables: ${affected.size}`,
  );

  console.log(
    "API calls today:",
    `${day.requestsMade} / ${DAILY_LIMIT}`,
  );

  console.log(
    "Remaining:",
    Math.max(
      0,
      DAILY_LIMIT -
        day.requestsMade,
    ),
  );

  if (
    result.remaining != null
  ) {
    console.log(
      "Provider reports requests remaining:",
      result.remaining,
    );
  }

  console.log(
    "TFD rebuild:",
    matched > 0
      ? "completed"
      : "not required",
  );
}
