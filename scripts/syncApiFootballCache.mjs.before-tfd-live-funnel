import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";

const root = process.cwd();
const secretsPath = resolve(root, ".ticket-frame-api-secrets");
const cachePath = resolve(root, "data/apiFootballCache.json");
const matchDbPath = resolve(root, "data/matchDatabase.json");

const DAILY_LIMIT = 100;
const RESERVED_CALLS = 20;
const LIVE_BUDGET = DAILY_LIMIT - RESERVED_CALLS;

function readSecrets() {
  if (!existsSync(secretsPath)) throw new Error("Missing .ticket-frame-api-secrets");

  return Object.fromEntries(
    readFileSync(secretsPath, "utf8")
      .split(/\r?\n/)
      .map((line) => line.trim())
      .filter((line) => line && !line.startsWith("#") && line.includes("="))
      .map((line) => {
        const i = line.indexOf("=");
        return [line.slice(0, i).trim(), line.slice(i + 1).trim()];
      }),
  );
}

function loadJson(path, fallback) {
  if (!existsSync(path)) return fallback;
  return JSON.parse(readFileSync(path, "utf8"));
}

function saveJson(path, value) {
  writeFileSync(path, `${JSON.stringify(value, null, 2)}\n`, "utf8");
}

function dateOnly(value) {
  return String(value ?? "").slice(0, 10);
}

function kickoffMinutes(match) {
  const value = match.kickoff;
  if (!value) return null;

  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return null;

  return date.getUTCHours() * 60 + date.getUTCMinutes();
}

function todaysMatches(database, today) {
  const result = [];

  for (const seasons of Object.values(database.competitions ?? {})) {
    for (const bundle of Object.values(seasons ?? {})) {
      for (const match of bundle.fixtures ?? []) {
        if (dateOnly(match.date ?? match.kickoff) === today) result.push(match);
      }
    }
  }

  return result;
}

function kickoffBlocks(matches) {
  const values = [...new Set(
    matches
      .map(kickoffMinutes)
      .filter((value) => value != null),
  )].sort((a, b) => a - b);

  return values;
}

function initialIntervalMinutes(blockCount) {
  if (blockCount <= 1) return 2;
  if (blockCount === 2) return 4;
  if (blockCount === 3) return 6;
  return 8;
}

function calculatePlan(matches) {
  const blocks = kickoffBlocks(matches);

  const rawWindows = blocks.map((start) => ({
    start,
    end: start + 120,
    kickoffBlocks: [start],
  }));

  // Merge overlapping kickoff windows. One live API request updates
  // every match currently in play, so overlaps are especially efficient.
  const mergedWindows = [];

  for (const window of rawWindows) {
    const previous = mergedWindows[mergedWindows.length - 1];

    if (previous && window.start <= previous.end) {
      previous.end = Math.max(previous.end, window.end);
      previous.kickoffBlocks.push(...window.kickoffBlocks);
    } else {
      mergedWindows.push({ ...window });
    }
  }

  const preferredInterval = (blockCount) => {
    if (blockCount <= 1) return 2;
    if (blockCount === 2) return 4;
    if (blockCount === 3) return 6;
    return 8;
  };

  // Give overlapping windows extra weight because every request
  // updates more kickoff groups at once.
  const weighted = mergedWindows.map((window) => {
    const durationMinutes = window.end - window.start;
    const blockCount = window.kickoffBlocks.length;

    return {
      ...window,
      durationMinutes,
      blockCount,
      weight: 1 + Math.max(0, blockCount - 1) * 0.5,
    };
  });

  const totalWeightedMinutes = weighted.reduce(
    (sum, window) => sum + window.durationMinutes * window.weight,
    0,
  );

  let callsLeft = LIVE_BUDGET;

  const windows = weighted.map((window, index) => {
    const proportionalCalls = Math.max(
      1,
      Math.floor(
        LIVE_BUDGET *
        ((window.durationMinutes * window.weight) / totalWeightedMinutes),
      ),
    );

    let allocatedCalls = Math.min(callsLeft, proportionalCalls);

    // Keep enough calls available for every remaining window.
    const remainingWindows = weighted.length - index - 1;
    allocatedCalls = Math.min(
      allocatedCalls,
      Math.max(1, callsLeft - remainingWindows),
    );

    let intervalMinutes = Math.max(
      1,
      Math.ceil(window.durationMinutes / allocatedCalls),
    );

    const preferred = preferredInterval(window.blockCount);

    // Overlap earns a faster target than the basic block rule.
    const overlapReduction =
      window.blockCount > 1
        ? Math.min(2, window.blockCount - 1)
        : 0;

    const overlapTarget = Math.max(2, preferred - overlapReduction);

    // Use the fastest rate we can safely afford.
    intervalMinutes = Math.max(intervalMinutes, overlapTarget);

    // Isolated kickoff windows should never become excessively slow.
    // Use spare daily quota to keep them at no worse than 10 minutes.
    if (window.blockCount === 1) {
      intervalMinutes = Math.min(intervalMinutes, 10);
    }

    const estimatedCalls = Math.ceil(
      window.durationMinutes / intervalMinutes,
    );

    callsLeft = Math.max(0, callsLeft - estimatedCalls);

    return {
      index: index + 1,
      startUtcMinutes: window.start,
      endUtcMinutes: window.end,
      durationMinutes: window.durationMinutes,
      kickoffBlockCount: window.blockCount,
      kickoffBlocksUtcMinutes: window.kickoffBlocks,
      intervalMinutes,
      estimatedCalls,
    };
  });

  return {
    matchCount: matches.length,
    blockCount: blocks.length,
    liveWindowCount: windows.length,
    kickoffBlocksUtcMinutes: blocks,
    estimatedLiveMinutes: windows.reduce(
      (sum, window) => sum + window.durationMinutes,
      0,
    ),
    dailyLimit: DAILY_LIMIT,
    reservedCalls: RESERVED_CALLS,
    liveBudget: LIVE_BUDGET,
    windows,
    estimatedLiveCalls: windows.reduce(
      (sum, window) => sum + window.estimatedCalls,
      0,
    ),
  };
}

async function apiFootball(path, apiKey) {
  const response = await fetch(`https://v3.football.api-sports.io${path}`, {
    headers: { "x-apisports-key": apiKey },
  });

  const body = await response.json();

  return {
    ok: response.ok,
    status: response.status,
    body,
    remaining:
      response.headers.get("x-ratelimit-requests-remaining") ??
      response.headers.get("x-ratelimit-remaining"),
  };
}

const args = new Set(process.argv.slice(2));
const planOnly = args.has("--plan-only");

const database = loadJson(matchDbPath, { competitions: {} });

const requestedDateArg = process.argv.find((arg) => arg.startsWith("--date="));
const today = requestedDateArg
  ? requestedDateArg.slice("--date=".length)
  : new Date().toISOString().slice(0, 10);

const matches = todaysMatches(database, today);
const plan = calculatePlan(matches);

console.log("===== TICKET FRAME LIVE PLAN =====");
console.log("Date:", today);
console.log("Matches:", plan.matchCount);
console.log("Kickoff blocks:", plan.blockCount);
console.log("Live windows:", plan.liveWindowCount);
console.log("Reserved API calls:", plan.reservedCalls);
console.log("Live-call budget:", plan.liveBudget);
console.log("Estimated live calls:", plan.estimatedLiveCalls);

for (const window of plan.windows) {
  const hhmm = (minutes) =>
    `${String(Math.floor(minutes / 60)).padStart(2, "0")}:${String(minutes % 60).padStart(2, "0")}`;

  console.log(
    `Window ${window.index}: ${hhmm(window.startUtcMinutes)}-${hhmm(window.endUtcMinutes)} UTC | ` +
    `${window.kickoffBlockCount} kickoff block(s) | every ${window.intervalMinutes} min | ` +
    `~${window.estimatedCalls} calls`,
  );
}

if (planOnly) {
  console.log("Plan only — API-Football was NOT contacted.");
  process.exit(0);
}

const secrets = readSecrets();

if (!secrets.API_FOOTBALL_KEY) {
  throw new Error("API_FOOTBALL_KEY is missing.");
}

const cache = loadJson(cachePath, {
  schemaVersion: 1,
  provider: "api-football",
  days: {},
});

cache.days[today] ??= {
  plan,
  requestsMade: 0,
  liveSnapshots: [],
  completedFixtures: {},
};

cache.days[today].plan = plan;

if (!matches.length) {
  saveJson(cachePath, cache);
  console.log("No TFD matches today. No API request required.");
  process.exit(0);
}

if (cache.days[today].requestsMade >= LIVE_BUDGET) {
  console.log("Protected live-call budget reached. No API request made.");
  process.exit(0);
}

// One request can return all currently-live API-Football fixtures.
const result = await apiFootball("/fixtures?live=all", secrets.API_FOOTBALL_KEY);

if (!result.ok) {
  console.error("API-Football request failed:", result.status);
  process.exitCode = 1;
} else {
  cache.days[today].requestsMade += 1;
  cache.days[today].liveSnapshots.push({
    fetchedAt: new Date().toISOString(),
    remaining: result.remaining,
    fixtures: result.body.response ?? [],
  });

  saveJson(cachePath, cache);

  console.log(
    `Live snapshot saved: ${(result.body.response ?? []).length} live fixture(s).`,
  );

  if (result.remaining != null) {
    console.log("Provider reports requests remaining:", result.remaining);
  }
}
